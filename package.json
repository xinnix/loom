{
  "name": "loom",
  "version": "1.0.0",
  "description": "Full-stack autonomous scaffold with NestJS + tRPC + Refine + UniApp",
  "scripts": {
    "sync": "./scripts/sync-all.sh",
    "type-check": "./scripts/type-check.sh",
    "dev": "pnpm -r --parallel --filter \"@loom/api\" --filter \"admin\" run dev",
    "dev:api": "pnpm -C apps/api dev",
    "dev:admin": "pnpm -C apps/admin dev",
    "dev:miniapp": "pnpm -C apps/miniapp dev",
    "dev:web": "pnpm -C apps/web dev",
    "dev:landing": "pnpm -C apps/landing dev",
    "dev:all": "pnpm -r --parallel run dev",
    "db:generate": "pnpm -C infra/database prisma generate",
    "db:migrate": "pnpm -C infra/database prisma migrate dev",
    "db:studio": "pnpm -C infra/database prisma studio",
    "build:api": "pnpm -C apps/api build",
    "build:admin": "pnpm -C apps/admin build",
    "build:miniapp": "pnpm -C apps/miniapp build",
    "build:web": "pnpm -C apps/web build",
    "build:landing": "pnpm -C apps/landing build",
    "build:shared": "pnpm -C infra/shared build",
    "test": "pnpm --filter !@loom/miniapp -r run test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "lint": "pnpm -r --parallel run lint",
    "lint:fix": "pnpm -r --parallel run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "nestjs",
    "trpc",
    "refine",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "tsx": "4.23.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "ali-oss": "^6.23.0"
  },
  "pnpm": {
    "overrides": {
      "unconfig": "7.3.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "antd": "6",
        "yargs": "18",
        "typescript": "7",
        "vite": "8",
        "vue": "3.5",
        "@vitejs/plugin-vue": "5",
        "eslint": "10",
        "@antfu/eslint-config": "4",
        "@uni-helper/uni-cloud-types": "1.0.0-alpha.6",
        "@uni-helper/uni-ui-types": "1.0.0-alpha.6",
        "@uni-helper/uni-app-types": "1.0.0-alpha.6",
        "unocss-applet": "0.12.2",
        "@dcloudio/types": "3.4.32"
      }
    }
  }
}
