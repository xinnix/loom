generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 管理端用户模型 (Admin)
// ============================================
model Admin {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  avatar        String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // 关联
  refreshTokens AdminRefreshToken[]
  roles         AdminRole[]
  agentCreatedBy Agent[] @relation("AgentCreatedBy")
  agentUpdatedBy Agent[] @relation("AgentUpdatedBy")
  llmConfigCreatedBy LlmConfig[] @relation("LlmConfigCreatedBy")
  llmConfigUpdatedBy LlmConfig[] @relation("LlmConfigUpdatedBy")
  wecomConfigCreatedBy WecomConfig[] @relation("WecomConfigCreatedBy")
  wecomConfigUpdatedBy WecomConfig[] @relation("WecomConfigUpdatedBy")

  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("admins")
}

// ============================================
// 小程序用户模型 (User)
// ============================================
model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String? // 可选字段（微信用户不需要）
  passwordHash String

  // 微信相关字段
  openid     String? @unique // 微信用户唯一标识
  unionid    String? @unique // 开放平台标识（可选）
  sessionKey String? // 会话密钥（加密存储）

  phone       String?
  avatar      String?
  nickname    String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // 关联
  refreshTokens UserRefreshToken[]
  todos         Todo[]
  agentSessions AgentSession[]

  @@index([openid])
  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("users")
}

// ============================================
// 角色模型 (仅用于 Admin)
// ============================================
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  level       Int      @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // 关联
  permissions RolePermission[]
  admins      AdminRole[]

  @@index([slug])
  @@index([deletedAt])
  @@map("roles")
}

// ============================================
// 权限模型
// ============================================
model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  // 关联
  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([deletedAt])
  @@map("permissions")
}

// ============================================
// Admin 角色关联
// ============================================
model AdminRole {
  id         String   @id @default(cuid())
  adminId    String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  // 关联
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, roleId])
  @@index([adminId])
  @@index([roleId])
  @@map("admin_roles")
}

// ============================================
// 角色权限关联
// ============================================
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  // 关联
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================
// Admin 刷新令牌
// ============================================
model AdminRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  // 关联
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
  @@map("admin_refresh_tokens")
}

// ============================================
// User 刷新令牌
// ============================================
model UserRefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  // 关联
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_refresh_tokens")
}

// ============================================
// LlmConfig 模型（AI 第 1 层：LLM 配置）
// apiKey 经 AES-256-GCM 加密存 apiKeyEnc，明文永不落库/回传/入日志
// ============================================
model LlmConfig {
  id          String   @id @default(cuid())
  name        String // 显示名，如 "DeepSeek 生产"
  configKey   String   @unique // 程序引用键，YML 节点 llm: configKey
  provider    String   @default("openai") // pi provider 键，MVP 仅 openai（兼容 openai-compatible 端点）
  apiUrl      String   @default("https://api.openai.com/v1")
  apiKeyEnc   String // "v1:" + base64(iv | authTag | ciphertext)
  apiKeyMask  String? // 展示掩码，如 "sk-***abcd"
  model       String // 默认模型名
  temperature Float?
  maxTokens   Int?
  timeoutMs   Int      @default(60000)
  maxRetries  Int      @default(1)
  isDefault   Boolean  @default(false) // 全局默认（应用层保证唯一）
  isActive    Boolean  @default(true)
  description String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Admin? @relation("LlmConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("LlmConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  agents Agent[]

  @@map("llm_configs")
}

// ============================================
// AgentRun 模型（AI 第 3 层：执行记录，最小 observability）
// ============================================
model AgentRun {
  id              String   @id @default(cuid())
  agentId         String? // FK → Agent，YML 移除后 run 仍可考
  agent           Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentSlug       String // 冗余常驻，YML 删除后仍可读
  status          String   @default("running") // running | success | failed | truncated
  input           Json
  output          String?
  error           String?
  nodeTrace       Json? // [{nodeId,type,iterations,toolCalls:[{name,args,ok,ms}],durationMs,warnings}]
  usage           Json? // {calls,promptTokens,completionTokens,totalTokens}
  durationMs      Int?
  triggeredById   String? // 无 FK（admin/user 双源）
  triggeredByType String? // "admin" | "user"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentSlug, createdAt])
  @@index([status])
  @@map("agent_runs")
}

// ============================================
// AgentSession / AgentMessage 模型（AI 第 3 层：用户端多轮会话，ADR-006）
// 会话作用域仅用户端：归属恒为 User（admin 调用会话端点 403）
// ============================================
model AgentSession {
  id            String   @id @default(cuid())
  agentSlug     String // 冗余常驻：会话绑定单一 agent，不跨 agent 复用
  title         String? // 首条用户消息截断生成
  lastMessageAt DateTime @default(now()) // 会话列表排序键
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([userId, lastMessageAt])
  @@map("agent_sessions")
}

model AgentMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant
  content   String
  runId     String? // → AgentRun 审计关联（无 FK，同 AgentRun.triggeredById 风格）
  createdAt DateTime @default(now())

  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("agent_messages")
}

// ============================================
// Agent 模型（AI 第 3 层：部署期绑定记录）
// 编排定义真理源在 YML（apps/api/src/ai/definitions/agents/），
// DB 行只保留部署期关注点，由 loader 按 slug upsert 同步展示字段
// ============================================
model Agent {
  id          String   @id @default(cuid())
  slug        String   @unique // = YML agent.name = REST 触发路径段
  name        String // loader 从 YML 同步的展示缓存
  description String?
  icon        String?
  llmConfigId String? // Agent 级默认模型配置（节点无 llm: 时回退，D3）
  llmConfig   LlmConfig? @relation(fields: [llmConfigId], references: [id], onDelete: SetNull)
  tools       Json? // Agent 级默认工具清单 string[]（loop 节点无 tools: 时回退）
  isActive    Boolean  @default(true) // kill switch（DB 权威，loader 不覆盖）
  sort        Int      @default(0) // DB 权威
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Admin? @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("AgentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  runs AgentRun[]

  @@index([isActive])
  @@map("agents")
}

// ============================================
// 企业微信应用配置 (WecomConfig)
// ============================================
model WecomConfig {
  id             String   @id @default(cuid())
  name           String
  corpId         String
  agentId        Int
  secret         String
  token          String
  encodingAESKey String
  description    String?
  isActive       Boolean  @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联
  messages  WecomMessage[]
  events    WecomEvent[]
  createdBy Admin? @relation("WecomConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin? @relation("WecomConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([corpId, agentId])
  @@index([corpId])
  @@index([isActive])
  @@map("wecom_configs")
}

// ============================================
// 企业微信消息记录 (WecomMessage)
// ============================================
model WecomMessage {
  id        String   @id @default(cuid())
  configId  String
  direction String
  msgType   String
  fromUser  String?
  toUser    String?
  content   String?
  rawXml    String?
  createdAt DateTime @default(now())

  config WecomConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([createdAt])
  @@map("wecom_messages")
}

// ============================================
// 企业微信事件记录 (WecomEvent)
// ============================================
model WecomEvent {
  id        String   @id @default(cuid())
  configId  String
  eventType String
  eventKey  String?
  fromUser  String?
  content   String?
  rawXml    String?
  createdAt DateTime @default(now())

  config WecomConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([eventType])
  @@index([createdAt])
  @@map("wecom_events")
}

// ============================================
// Todo 示例模型
// ============================================
// 这是一个完整的参考示例，演示如何创建一个标准的业务模块。
// 它展示了：
//   - 基础字段（title, description）
//   - 状态枚举字段（status）
//   - 优先级字段（priority）
//   - 可选日期字段（dueDate）
//   - 布尔字段（isCompleted）
//   - 用户关联（外键）
//   - 审计字段（timestamps）
//
// 配套查看：infra/shared/src/schemas/todo/（Zod 验证）
//           apps/api/src/modules/todo/（后端 API）
//           apps/admin/src/modules/todo/（Admin 端）
//           apps/web/src/app/(protected)/todos/（Web 端）
//           apps/miniapp/src/pages/todos/（小程序端）
// ============================================
model Todo {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending") // pending | in_progress | completed | cancelled
  priority    Int      @default(0)          // 0-low, 1-medium, 2-high
  dueDate     DateTime?
  isCompleted Boolean  @default(false)

  // 用户关联
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 审计
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([isCompleted])
  @@index([createdAt])
  @@map("todos")
}

